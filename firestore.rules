rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{document=**} {
      allow read: if true;
    }

    // Products collection: Public read and write for catalog, seeding, and updates
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders collection: Public create for guest checkouts, public read and update for orders and admin tracking
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Admins collection: Public read and write for admin role management
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
