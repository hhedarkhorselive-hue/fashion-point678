{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Fashion Point product entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array" },
        "videoUrl": { "type": "string" },
        "description": { "type": "string" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "stock": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price", "imageUrl"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "ship": { "type": "number" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "addr": { "type": "string" },
        "dist": { "type": "string" },
        "pay": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "items", "total", "name", "phone", "addr"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user entity",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products collection"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders collection"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admins collection for role verification"
    }
  }
}
